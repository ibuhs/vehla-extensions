{
  "apiVersion": 2,
  "id": "com.ibuhs.vehla.type-polish",
  "name": "Type Polish",
  "version": "1.0.0",
  "description": "QuickGlass actions for selected prose: straighten quotes, clean dashes, unwrap hard line breaks, collapse spaces, and strip invisible junk — off the main thread.",
  "author": "ibuhs",
  "runtime": "nativeUI",
  "entrypoint": "bin/TypePolishWorkspace.bundle",
  "commands": [
    {
      "id": "open-type-polish",
      "title": "Open Type Polish",
      "subtitle": "QuickGlass actions for cleaning selected prose",
      "keywords": ["quotes", "dash", "ellipsis", "unwrap", "nbsp", "plain", "typography"],
      "systemImage": "textformat.abc",
      "workspaceID": "type-polish"
    }
  ],
  "capabilities": ["persistentStorage", "selectedText"],
  "workspaces": [
    {
      "id": "type-polish",
      "title": "Type Polish",
      "subtitle": "QuickGlass prose cleanup",
      "systemImage": "textformat.abc",
      "preferredWidth": 720,
      "preferredHeight": 560,
      "minimumWidth": 560,
      "minimumHeight": 420,
      "dismissOnResignKey": true
    }
  ],
  "quickGlassActions": [
    {"id": "type.straighten-quotes", "title": "Straighten Quotes", "systemImage": "quote.closing", "delivery": "replaceSelection"},
    {"id": "type.clean-dashes", "title": "Clean Dashes", "systemImage": "minus", "delivery": "replaceSelection"},
    {"id": "type.unwrap", "title": "Unwrap Lines", "systemImage": "text.justify.left", "delivery": "replaceSelection"},
    {"id": "type.collapse-spaces", "title": "Collapse Spaces", "systemImage": "arrow.left.and.right", "delivery": "replaceSelection"},
    {"id": "type.strip-junk", "title": "Strip Invisible", "systemImage": "eraser", "delivery": "replaceSelection"},
    {"id": "type.polish", "title": "Polish Text", "systemImage": "sparkles", "delivery": "replaceSelection"}
  ]
}
