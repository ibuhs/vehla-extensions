{
  "apiVersion": 3,
  "id": "com.wiseman.vehla.quicknote",
  "name": "QuickNote",
  "version": "2.1.9",
  "description": "A native scratchpad with checklists, calculations, capture, permanent slots and safe Antinote import.",
  "author": "Michael Wiseman",
  "runtime": "dockWidget",
  "entrypoint": "bin/QuickNoteDockWidget.bundle",
  "capabilities": [
    "persistentStorage",
    "openURL",
    "clipboardRead",
    "clipboardWrite",
    "userSelectedFiles",
    "appActions"
  ],
  "dockWidgets": [
    {
      "id": "quicknote",
      "title": "QuickNote",
      "subtitle": "A scratchpad for the present moment",
      "systemImage": "note.text",
      "preferredPopupWidth": 760,
      "preferredPopupHeight": 680,
      "supportedSurfaces": [
        "compact",
        "inline",
        "popup"
      ]
    }
  ]
}
