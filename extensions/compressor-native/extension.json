{
  "apiVersion": 2,
  "id": "com.ahmadjerow.compressor-glass",
  "name": "Compressor Glass",
  "version": "1.3.0",
  "description": "Compress images, videos, PDFs and files without visible quality loss, in a tinted Liquid Glass window.",
  "author": "Ahmad Jerow",
  "runtime": "nativeUI",
  "entrypoint": "bin/CompressorWorkspace.bundle",
  "commands": [
    {
      "id": "open-compressor",
      "title": "Open Compressor",
      "subtitle": "Drop files, pick a folder, compress",
      "keywords": ["compressor", "squeeze", "shrink"],
      "systemImage": "arrow.down.right.and.arrow.up.left",
      "workspaceID": "compressor"
    }
  ],
  "capabilities": ["persistentStorage", "notifications"],
  "workspaces": [
    {
      "id": "compressor",
      "title": "Compressor",
      "subtitle": "Smaller files, same quality",
      "systemImage": "arrow.down.right.and.arrow.up.left",
      "preferredWidth": 800,
      "preferredHeight": 760,
      "minimumWidth": 780,
      "minimumHeight": 520,
      "dismissOnResignKey": false
    }
  ]
}
