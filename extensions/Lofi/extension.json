{
  "apiVersion": 3,
  "id": "com.ibuhs.vehla.lofi",
  "name": "Lofi",
  "version": "1.1.0",
  "description": "A cozy local music player with a user-selected source folder, fair shuffle, and playback controls.",
  "author": "ibuhs",
  "runtime": "dockWidget",
  "entrypoint": "bin/LofiDockWidget.bundle",
  "capabilities": ["persistentStorage"],
  "dockWidgets": [{
    "id": "lofi", "title": "Lofi", "subtitle": "Music from your chosen folder",
    "systemImage": "music.note", "preferredPopupWidth": 420, "preferredPopupHeight": 720,
    "supportedSurfaces": ["compact", "inline", "popup"]
  }]
}
