{
  "schemaVersion": 1,
  "packages": [
    {
      "manifest": {
        "apiVersion": 4,
        "id": "com.ibuhs.vehla.docker-notch",
        "name": "Docker Containers",
        "version": "1.1.0",
        "description": "Your Docker containers in the Notch: start, stop and restart them, and see at once when one stops.",
        "author": "ibuhs",
        "runtime": "notch",
        "entrypoint": "bin/DockerNotch.bundle",
        "capabilities": [
          "persistentStorage"
        ],
        "notch": {
          "background": true,
          "tabs": [
            {
              "id": "containers",
              "title": "Docker",
              "systemImage": "shippingbox.fill",
              "height": 260
            }
          ],
          "activities": [
            {
              "id": "stopped",
              "title": "A container stopped"
            },
            {
              "id": "unhealthy",
              "title": "A container is unhealthy"
            }
          ]
        }
      },
      "archiveURL": "https://raw.githubusercontent.com/ibuhs/vehla-extensions/main/packages/docker-notch-1.1.0.zip",
      "sha256": "4ee45128ca30498916d90f14b0fb01b9606da249b773f65e9d000201b2c05037",
      "archiveRoot": "docker-notch",
