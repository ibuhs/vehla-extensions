        "entrypoint": "index.js",
        "commands": [
          {
            "id": "start",
            "title": "Start Focus Timer",
            "subtitle": "Type the minutes, or leave empty for 25",
            "keywords": [
              "focus",
              "pomodoro",
              "timer"
            ],
            "systemImage": "timer"
          },
          {
            "id": "stop",
            "title": "Stop Focus Timer",
            "subtitle": "Take the timer out of the Notch",
            "keywords": [
              "focus",
              "pomodoro",
              "stop"
            ],
            "systemImage": "stop.circle"
          }
        ],
        "capabilities": [],
        "notch": {
          "activities": [
            {
              "id": "focus",
              "title": "Focus timer"
            }
          ]
